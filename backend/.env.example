# Application
APP_NAME="PYQ Analyzer"
DEBUG=false
CORS_ORIGINS=["http://localhost:5173"]

# Database
DATABASE_URL="sqlite+aiosqlite:///./pyq_analyzer.db"

# Redis & Celery (Optional - in-memory EventBus used by default)
REDIS_URL="redis://localhost:6379/0"
CELERY_BROKER_URL="redis://localhost:6379/0"
CELERY_RESULT_BACKEND="redis://localhost:6379/1"

# Storage & Vector Database
UPLOAD_DIR="./uploads"
ASSETS_DIR="./assets"
REPORTS_DIR="./reports"
CHROMA_PERSIST_DIR="./chroma_data"
EMBEDDING_MODEL="nomic-embed-text:latest"

# Local LLM Routing (Ollama)
OLLAMA_BASE_URL="http://127.0.0.1:11434"
OLLAMA_OCR_MODEL="hf.co/sahilchachra/Unlimited-OCR-GGUF:Q4_K_M"
OLLAMA_VISION_FALLBACK_MODEL="moondream:latest"
OLLAMA_STRUCTURING_MODEL="huihui_ai/gemma-4-abliterated:e4b"
OLLAMA_SYLLABUS_MODEL="huihui_ai/gemma-4-abliterated:e4b"
OLLAMA_PREDICTION_MODEL="huihui_ai/gemma-4-abliterated:e4b"
OLLAMA_EVALUATION_MODEL="huihui_ai/gemma-4-abliterated:e4b"

# Cloud LLM Fallback (Optional)
CLOUD_LLM_PROVIDER="none" # "openai", "google", "anthropic", or "none"
CLOUD_LLM_API_KEY=""
CLOUD_LLM_MODEL=""
