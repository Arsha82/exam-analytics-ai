# Local configuration overrides for backend/app/config.py
# Copy this file to .env to customize your local settings.

# App
# DEBUG=false
# CORS_ORIGINS=["http://localhost:5173"]

# Ollama (Local OCR and LLM models)
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_OCR_MODEL=hf.co/sahilchachra/Unlimited-OCR-GGUF:Q4_K_M

# Antigravity CLI (Gemini web discovery and transcription repair)
# AGY_BIN=agy
# AGY_ENABLED=true

# Cloud LLM (Optional fallback)
# CLOUD_LLM_PROVIDER=none # "openai", "google", "anthropic", "none"
# CLOUD_LLM_API_KEY=
# CLOUD_LLM_MODEL=
